<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
	<meta charset="utf-8" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Postdocs in Boston</title>
	<!-- Bulma Version 1, compiled locally with our brand color as $primary -->
	<link rel="stylesheet" href="css/bulma.css" />
	<link rel="stylesheet" type="text/css" href="css/showcase.css" />
	<link
	rel="stylesheet"
	href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
	integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
	crossorigin="anonymous"
	referrerpolicy="no-referrer"
	/>
	<link rel="icon" type="image/png" href="favicon.png" />
</head>

<body>
	<!-- Begin Scroll Up Button -->
	
	<form action="#home">
		<button id="toTop" title="Go to top">
			<i class="fas fa-angle-up"></i>
		</button>
	</form>
	<!-- End Scroll Up Button -->
	
	<!-- Begin Header -->
	<div class="header-wrapper" id="home">
		<!-- Begin Hero -->
		<section class="hero is-fullheight">
			<!-- Begin Mobile Nav -->
			<nav class="navbar is-fixed-top is-transparent is-hidden-desktop">
				<!-- Begin Burger Menu -->
				<div class="navbar-brand">
					<div class="navbar-burger burger" data-target="mobile-nav">
						<span></span>
						<span></span>
						<span></span>
					</div>
				</div>
				<!-- End Burger Menu -->
				<div id="mobile-nav" class="navbar-menu">
					<div class="navbar-end">
						<div class="navbar-item">
							<a class="navbar-item" href="#home">
								Home
							</a>
						</div>
						<div class="navbar-item">
							<a class="navbar-item" href="#our-mission">
								Our Mission
							</a>
						</div>
						<div class="navbar-item">
							<a class="navbar-item" href="#the-team">
								The Team
							</a>
						</div>
						<div class="navbar-item">
							<a class="navbar-item" href="#join-the-movement">
								Join The Movement
							</a>
						</div>
						<div class="navbar-item">
							<a class="navbar-item js-modal-trigger" data-target="contact-modal" href="#contact-modal">
								Contact Us
							</a>
						</div>
					</div>
				</div>
			</nav>
			<!-- End Mobile Nav -->
			<!-- Begin Hero Content-->
			<div class="hero-body">
				<div class="container has-text-centered">
					<img class="hero-logo" src="images/postdocsinboston_logo.png" alt="Logo of Postdocs in Boston" />
					<div class="hero-social">
						<a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
						<a href="#" aria-label="LinkedIn"><i class="fab fa-linkedin"></i></a>
						<a href="#" aria-label="X"><i class="fa-brands fa-x-twitter"></i></a>
					</div>
				</div>
			</div>
			<!-- End Hero Content-->
			<!-- Begin Hero Menu -->
			<div class="hero-foot ">
				<div class="hero-foot--wrapper">
					<div class="columns">
						<div class="column is-12 hero-menu-desktop has-text-centered is-fixed-top">
							<ul>
								<li class="is-active">
									<a href="#home">Home</a>
								</li>
								<li>
									<a href="#our-mission">Our Mission</a>
								</li>
								<li>
									<a href="#the-team">The Team</a>
								</li>
								<li>
									<a href="#join-the-movement">Join The Movement</a>
								</li>
								<li>
									<a class="js-modal-trigger" data-target="contact-modal" href="#contact-modal">Contact Us</a>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
			<!-- End Hero Menu -->
		</section>
		<!-- End Hero -->
	</div>
	<!-- End Header -->
	
	<!-- Begin Our Mission Section -->
	<section class="section section-light about-me" id="our-mission">
		<div class="container">
			<div class="column is-12 about-me">
				<h1 class="title has-text-centered section-title">Our Mission</h1>
			</div>
			<div class="columns is-multiline">
				<div
				class="column is-6 has-vertically-aligned-content"
				data-aos="fade-right"
				>
					<p class="is-larger">
						&emsp;&emsp;<strong
						>A global postdoc community without borders. Postdocs in
						Boston unites postdocs across Boston and beyond to advance
						science and build a better future together.</strong
						>
					</p>
					<br />
					<p>
						We connect talented researchers across Boston institutions
						while building bridges between the United States
						and the global research community &mdash; bringing postdocs
						together to support, inspire, and empower each other.
					</p>
				</div>
				<div class="column is-6 right-image " data-aos="fade-left">
					<img
					class="is-rounded"
					src="https://picsum.photos/id/366/600/375"
					alt="Postdocs in Boston community gathering"
					/>
				</div>
			</div>
			<article class="message is-primary ">
				<div class="message-header has-text-centered">
					<span>Our 6 Pillars</span>
				</div>
				<div class="message-body">
					<div class="columns is-multiline">
						<div class="column is-4 has-text-centered ">
							<p class="title is-2"><i class="fas fa-users"></i></p>
							<p class="subtitle is-4 has-text-weight-semibold mb-1">Community</p>
							<p class="is-size-7 is-hidden-mobile">Social events &middot; Peer support &middot; Lasting friendships &middot; A sense of belonging</p>
						</div>
						<div class="column is-4 has-text-centered ">
							<p class="title is-2"><i class="fas fa-microscope"></i></p>
							<p class="subtitle is-4 has-text-weight-semibold mb-1">Research Collaboration</p>
							<p class="is-size-7 is-hidden-mobile">Scientific exchange &middot; Interdisciplinary projects &middot; Shared resources &middot; Mentorship</p>
						</div>
						<div class="column is-4 has-text-centered ">
							<p class="title is-2"><i class="fas fa-chart-line"></i></p>
							<p class="subtitle is-4 has-text-weight-semibold mb-1">Career &amp; Leadership</p>
							<p class="is-size-7 is-hidden-mobile">Academic careers &middot; Industry pathways &middot; Entrepreneurship &middot; Leadership development</p>
						</div>
						<div class="column is-4 has-text-centered ">
							<p class="title is-2"><i class="fas fa-globe"></i></p>
							<p class="subtitle is-4 has-text-weight-semibold mb-1">Global Connections</p>
							<p class="is-size-7 is-hidden-mobile">International researchers &middot; Europe&ndash;USA collaborations &middot; Visiting scholars &middot; Cultural exchange</p>
						</div>
						<div class="column is-4 has-text-centered ">
							<p class="title is-2"><i class="fas fa-lightbulb"></i></p>
							<p class="subtitle is-4 has-text-weight-semibold mb-1">Innovation &amp; Entrepreneurship</p>
							<p class="is-size-7 is-hidden-mobile">Startups &middot; Venture capital &middot; Translational research &middot; Vision for real-world impact</p>
						</div>
						<div class="column is-4 has-text-centered ">
							<p class="title is-2"><i class="fas fa-landmark"></i></p>
							<p class="subtitle is-4 has-text-weight-semibold mb-1">Advocacy &amp; Representation</p>
							<p class="is-size-7 is-hidden-mobile">Postdoc voices &middot; Institutional partnerships &middot; Policy awareness &middot; Community building</p>
						</div>
					</div>
				</div>
			</article>
		</div>
	</section>
<!-- End Our Mission Content -->
<!-- Begin The Team Content -->
<section class="section section-dark my-work" id="the-team">
	<div class="container">
		<div
		class="columns is-multiline"
		data-aos="fade-in"
		data-aos-easing="linear"
		>
		<div class="column is-12">
			<h1 class="title has-text-centered section-title">The Team</h1>
		</div>
		<div class="column is-12 has-text-centered">
			<h2 class="subtitle">
				Five equals, one mission. Postdocs in Boston is run by a
				volunteer leadership team of postdocs from institutions
				across the city.
			</h2>
		</div>
		{% for member in team %}{% include "team-card.njk" %}{% endfor %}
		<div class="column is-12">
			<article class="message is-primary how-we-work-together">
			<div class="message-header has-text-centered">
				<span>How We Work Together</span>
			</div>
			<div class="message-body">
				<div class="level is-flex-wrap-wrap">
					<div class="level-item has-text-centered">
						<div>
							<p class="title is-3"><i class="fas fa-balance-scale"></i></p>
							<p class="subtitle is-5 has-text-weight-semibold">Non-hierarchical</p>
							<p class="is-size-7">Equal voices, equal votes</p>
						</div>
					</div>
					<div class="level-item has-text-centered">
						<div>
							<p class="title is-3"><i class="fas fa-heart"></i></p>
							<p class="subtitle is-5 has-text-weight-semibold">Respect</p>
							<p class="is-size-7">We listen and lift each other</p>
						</div>
					</div>
					<div class="level-item has-text-centered">
						<div>
							<p class="title is-3"><i class="fas fa-comments"></i></p>
							<p class="subtitle is-5 has-text-weight-semibold">Openness</p>
							<p class="is-size-7">Honest, transparent, kind</p>
						</div>
					</div>
					<div class="level-item has-text-centered">
						<div>
							<p class="title is-3"><i class="fas fa-users"></i></p>
							<p class="subtitle is-5 has-text-weight-semibold">Shared ownership</p>
							<p class="is-size-7">Each owns a domain, all own the mission</p>
						</div>
					</div>
				</div>
			</div>
		</article>
		</div>
		<div class="column is-12 has-text-centered">
			<button class="button cta-button js-modal-trigger" data-target="contact-modal">
				<span class="icon">
					<i class="fas fa-paper-plane"></i>
				</span>
				<span>Contact us</span>
			</button>
		</div>
	</div>
</div>
</section>
<!-- End The Team Content -->
<!-- Begin Join The Movement Content -->
<section class="section section-light services partners" id="join-the-movement">
	<div class="container">
		<div class="columns is-multiline">
			<div class="column is-12 about-me" data-aos="fade-in" data-aos-easing="linear">
				<h1 class="title has-text-centered section-title">
					Join The Movement
				</h1>
				
				<h2 class="subtitle">
					We are a community of postdocs in the Boston area coming
					together to support, inspire, and empower each other.
				</h2>
				<br />
			</div>
			<div class="columns is-12">
				<div class="column is-3 has-text-centered" data-aos="fade-in" data-aos-easing="linear">
					<i class="fas fa-calendar-alt fa-3x"></i>
					<hr />
					<h2>Events</h2>
					<p>Fun and professional events to connect, learn, and unwind together.</p>
				</div>
				<div class="column is-3 has-text-centered" data-aos="fade-in" data-aos-easing="linear">
					<i class="fas fa-comments fa-3x"></i>
					<hr />
					<h2>Exchange</h2>
					<p>Share ideas, resources, and experiences across research and beyond.</p>
				</div>
				<div class="column is-3 has-text-centered" data-aos="fade-in" data-aos-easing="linear">
					<i class="fas fa-user-friends fa-3x"></i>
					<hr />
					<h2>Meet &amp; Connect</h2>
					<p>Build relationships, make friends, and strengthen our postdoc network.</p>
				</div>
				<div class="column is-3 has-text-centered" data-aos="fade-in" data-aos-easing="linear">
					<i class="fas fa-bullhorn fa-3x"></i>
					<hr />
					<h2>Spread the Word</h2>
					<p>Together, we can increase visibility, create opportunities, and make an impact.</p>
				</div>
			</div>
			<div class="column is-12">
				<p class="partner-roster">{{ partners | proseList | safe }}</p>
				<p class="has-text-centered">&hearts; ...and all postdocs across Boston!</p>
			</div>
		</div>
	</div>
</section>
<!-- End Join The Movement Content -->

<!-- Begin Footer -->
<div class="footer">
	<div class="container">
		<div class="columns is-vcentered">
			<div class="column has-text-centered-mobile has-text-left-desktop">
				<p>
					Website by <a href="https://github.com/chourroutm">Matt Chourrout</a>.
					The source code is licensed
					<a href="http://opensource.org/licenses/mit-license.php">MIT</a>. The website content is licensed
					<a href="http://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY NC SA 4.0</a>. 
				</p>
			</div>
			<div class="column has-text-centered-mobile has-text-right-desktop">
				<button class="button cta-button js-modal-trigger" data-target="contact-modal">
					<span class="icon">
						<i class="fas fa-paper-plane"></i>
					</span>
					<span>Contact us</span>
				</button>
			</div>
		</div>
	</div>
</div>
<!-- End Footer -->

<!-- Begin Contact Modal -->
<div id="contact-modal" class="modal">
	<div class="modal-background"></div>
	<div class="modal-card">
		<header class="modal-card-head">
			<p class="modal-card-title">Contact Us</p>
			<button class="delete" aria-label="close"></button>
		</header>
		<form
		action="https://formspree.io/info@postdocsinboston.org"
		method="POST"
		>
		<section class="modal-card-body">
			<div class="field">
				<label class="label">Name</label>
				<div class="control has-icons-left">
					<input
					class="input"
					type="text"
					placeholder="Ex. Jane Smith"
					name="Name"
					/>
					<span class="icon is-small is-left">
						<i class="fas fa-user"></i>
					</span>
				</div>
			</div>
			<div class="field">
				<label class="label">Email</label>
				<div class="control has-icons-left">
					<input
					class="input"
					type="email"
					placeholder="Ex. hello@postdocsinboston.org"
					name="Email"
					/>
					<span class="icon is-small is-left">
						<i class="fas fa-envelope"></i>
					</span>
				</div>
			</div>
			<div class="field">
				<label class="label">Message</label>
				<div class="control">
					<textarea
					class="textarea"
					placeholder="Textarea"
					name="Message"
					></textarea>
				</div>
			</div>
		</section>
		<footer class="modal-card-foot">
			<div class="buttons">
				<button class="button is-primary">
					<span class="icon">
						<i class="fas fa-paper-plane"></i>
					</span>
					<span>Send</span>
				</button>
				<button type="button" class="button">Cancel</button>
			</div>
		</footer>
	</form>
</div>
</div>
<!-- End Contact Modal -->

<!-- Scripts -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
<script src="js/showcase.js"></script>
<link href="https://cdn.rawgit.com/michalsnik/aos/2.1.1/dist/aos.css" rel="stylesheet">
<script src="https://cdn.rawgit.com/michalsnik/aos/2.1.1/dist/aos.js"></script>
<script>
	AOS.init({
		easing: "ease-out",
		duration: 800,
	});
</script>
</body>
</html>
