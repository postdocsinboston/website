<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
	<meta charset="utf-8" />
	<meta http-equiv="X-UA-Compatible" content="IE=edge" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Postdocs in Boston</title>
	<!-- Bulma Version 1, compiled locally with our brand color as $primary -->
	<link rel="stylesheet" href="css/bulma.css" />
	<link rel="stylesheet" type="text/css" href="css/showcase.css" />
	<link
	rel="stylesheet"
	href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
	integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A=="
	crossorigin="anonymous"
	referrerpolicy="no-referrer"
	/>
	<link rel="icon" type="image/png" href="favicon.png" />
</head>

<body>
	<!-- Begin Scroll Up Button -->
	<form action="#home">
		<button id="toTop" title="Go to top">
			<i class="fas fa-angle-up"></i>
		</button>
	</form>
	<!-- End Scroll Up Button -->
	
	<!-- Begin Header -->
	<div class="header-wrapper" id="home">
		<!-- Begin Hero -->
		<section class="hero is-fullheight">
			<!-- Begin Mobile Nav -->
			<nav class="navbar is-fixed-top is-transparent is-hidden-desktop">
				<!-- Begin Burger Menu -->
				<div class="navbar-brand">
					<a class="navbar-burger" role="button" aria-label="menu" aria-expanded="false" data-target="mobile-nav">
						<span aria-hidden="true"></span>
						<span aria-hidden="true"></span>
						<span aria-hidden="true"></span>
						<span aria-hidden="true"></span>
					</a>
				</div>
				<!-- End Burger Menu -->
				<div id="mobile-nav" class="navbar-menu">
					<div class="navbar-end">
						<div class="navbar-item">
							<a class="navbar-item" href="#home">
								Home
							</a>
						</div>
						<div class="navbar-item">
							<a class="navbar-item" href="#our-mission">
								Our Mission
							</a>
						</div>
						<div class="navbar-item">
							<a class="navbar-item" href="#the-team">
								The Team
							</a>
						</div>
						<div class="navbar-item">
							<a class="navbar-item" href="#join-the-movement">
								Join The Movement
							</a>
						</div>
						<div class="navbar-item">
							<a class="navbar-item js-modal-trigger" data-target="contact-modal" href="#contact-modal">
								Contact Us
							</a>
						</div>
					</div>
				</div>
			</nav>
			<!-- End Mobile Nav -->
			<!-- Begin Hero Content-->
			<div class="hero-body">
				<div class="container has-text-centered">
					<img class="hero-logo" src="images/postdocsinboston_logo.png" alt="Logo of Postdocs in Boston" />
					<div class="hero-social">
					{% for social_media_entry in social_media %}
						<a href="{{ social_media_entry.url }}" aria-label="{{ social_media_entry.name }}">
							<span class="icon" aria-hidden="true">
								<i class="{{ social_media_entry.icon }}"></i>
							</span>
						</a>
					{% endfor %}
					</div>
				</div>
			</div>
			<!-- End Hero Content-->
			<!-- Begin Hero Menu -->
			<div class="hero-foot ">
				<div class="hero-foot--wrapper">
					<div class="columns">
						<div class="column is-12 hero-menu-desktop has-text-centered is-fixed-top">
							<ul>
								<li class="is-active">
									<a href="#home">Home</a>
								</li>
								<li>
									<a href="#our-mission">Our Mission</a>
								</li>
								<li>
									<a href="#the-team">The Team</a>
								</li>
								<li>
									<a href="#join-the-movement">Join The Movement</a>
								</li>
								<li>
									<a class="js-modal-trigger" data-target="contact-form-modal" href="#contact-form-modal">Contact Us</a>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
			<!-- End Hero Menu -->
		</section>
		<!-- End Hero -->
	</div>
	<!-- End Header -->
	
	<!-- Begin Our Mission Section -->
	<section class="section section-light about-me" id="our-mission">
		<div class="container">
			<h1 class="title section-title">Our Mission</h1>
			<h2 class="subtitle">A global postdoc community without borders</h2>
			<div class="columns is-multiline">
				<div
				class="column is-6 has-vertically-aligned-content"
				data-aos="fade-right"
				>
					<p class="has-text-weight-bold">
						<em>Postdocs in Boston</em> unites postdoctoral researchers across Boston and beyond to advance
						science and build a better future together.
					</p>
					<p>
						We connect talented researchers across Boston institutions
						while building bridges between the United States
						and the global research community &mdash; bringing postdocs
						together to support, inspire, and empower each other.
					</p>
				</div>
				<div class="column is-6" data-aos="fade-left">
					<div class="box p-0 mx-3 is-clipped">
						<figure class="image">
							<img
							src="https://picsum.photos/id/366/600/375"
							alt="Postdocs in Boston community gathering"
							/>
						</figure>
					</div>
				</div>
			</div>
			<article class="message is-primary" id="our-pillars">
				<div class="message-header has-text-centered">
					<span>Our 6 Pillars</span>
				</div>
				<div class="message-body">
					<div class="columns is-multiline">
						<div class="column is-4 has-text-centered">
							<p aria-hidden="true" class="title is-2"><i class="fas fa-people-group"></i></p>
							<p class="subtitle is-4 has-text-weight-semibold mb-1">Community</p>
							<p class="is-size-7 is-hidden-mobile">Social events &middot; Peer support &middot; Lasting friendships &middot; A sense of belonging</p>
						</div>
						<div class="column is-4 has-text-centered">
							<p aria-hidden="true" class="title is-2"><i class="fas fa-atom"></i></p>
							<p class="subtitle is-4 has-text-weight-semibold mb-1">Research Collaboration</p>
							<p class="is-size-7 is-hidden-mobile">Scientific exchange &middot; Interdisciplinary projects &middot; Shared resources &middot; Mentorship</p>
						</div>
						<div class="column is-4 has-text-centered">
							<p aria-hidden="true" class="title is-2"><i class="fas fa-chart-line"></i></p>
							<p class="subtitle is-4 has-text-weight-semibold mb-1">Career &amp; Leadership</p>
							<p class="is-size-7 is-hidden-mobile">Academic careers &middot; Industry pathways &middot; Entrepreneurship &middot; Leadership development</p>
						</div>
						<div class="column is-4 has-text-centered">
							<p aria-hidden="true" class="title is-2"><i class="fas fa-earth-americas"></i></p>
							<p class="subtitle is-4 has-text-weight-semibold mb-1">Global Connections</p>
							<p class="is-size-7 is-hidden-mobile">International researchers &middot; Europe&ndash;USA collaborations &middot; Visiting scholars &middot; Cultural exchange</p>
						</div>
						<div class="column is-4 has-text-centered">
							<p aria-hidden="true" class="title is-2"><i class="fas fa-lightbulb"></i></p>
							<p class="subtitle is-4 has-text-weight-semibold mb-1">Innovation &amp; Entrepreneurship</p>
							<p class="is-size-7 is-hidden-mobile">Startups &middot; Venture capital &middot; Translational research &middot; Vision for real-world impact</p>
						</div>
						<div class="column is-4 has-text-centered">
							<p aria-hidden="true" class="title is-2"><i class="fas fa-landmark"></i></p>
							<p class="subtitle is-4 has-text-weight-semibold mb-1">Advocacy &amp; Representation</p>
							<p class="is-size-7 is-hidden-mobile">Postdoc voices &middot; Institutional partnerships &middot; Policy awareness &middot; Community building</p>
						</div>
					</div>
				</div>
			</article>
		</div>
	</section>
<!-- End Our Mission Content -->
<!-- Begin The Team Content -->
<section class="section section-dark" id="the-team">
	<div class="container" data-aos="fade-in" data-aos-easing="linear">
		<h1 class="title">The Team</h1>
		<h2 class="subtitle">Five equals, one mission</h2>
		<p>
			<em>Postdocs in Boston</em> is run by a volunteer leadership team of postdoctoral fellows from institutions across the city.
		</p>
		<div class="columns is-multiline mt-3">
			{% for member in team %}{% include "team-card.njk" %}{% endfor %}
		</div>
		<article class="message is-primary" id="how-we-work-together">
			<div class="message-header has-text-centered">
				<span>How We Work Together</span>
			</div>
			<div class="message-body">
				<div class="level is-flex-wrap-wrap">
					<div class="level-item has-text-centered">
						<div>
							<p aria-hidden="true" class="title is-3"><i class="fas fa-balance-scale"></i></p>
							<p class="subtitle is-5 has-text-weight-semibold">Non-hierarchical</p>
							<p class="is-size-7">Equal voices, equal votes</p>
						</div>
					</div>
					<div class="level-item has-text-centered">
						<div>
							<p aria-hidden="true" class="title is-3"><i class="fas fa-heart"></i></p>
							<p class="subtitle is-5 has-text-weight-semibold">Respect</p>
							<p class="is-size-7">We listen and lift each other</p>
						</div>
					</div>
					<div class="level-item has-text-centered">
						<div>
							<p aria-hidden="true" class="title is-3"><i class="fas fa-comments"></i></p>
							<p class="subtitle is-5 has-text-weight-semibold">Openness</p>
							<p class="is-size-7">Honest, transparent, kind</p>
						</div>
					</div>
					<div class="level-item has-text-centered">
						<div>
							<p aria-hidden="true" class="title is-3"><i class="fas fa-users"></i></p>
							<p class="subtitle is-5 has-text-weight-semibold">Shared ownership</p>
							<p class="is-size-7">Each owns a domain, all own the mission</p>
						</div>
					</div>
				</div>
			</div>
		</article>
		<div class="is-flex is-justify-content-center is-align-items-center mt-2">
			<button class="button is-primary js-modal-trigger" data-target="contact-form-modal">
				<span class="icon">
					<i class="fas fa-paper-plane"></i>
				</span>
				<span>Contact us</span>
			</button>
		</div>
	</div>
</section>
<!-- End The Team Content -->
<!-- Begin Join The Movement Content -->
