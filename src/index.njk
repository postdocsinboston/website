		<div class="fixed-grid has-1-cols-mobile has-1-cols-tablet has-2-cols-desktop mt-3">
			<div class="grid is-gap-3">
				<div class="cell">
					<div class="card">
						<header class="card-header">
							<p class="card-header-title">Events</p>
							<div aria-hidden="true" class="card-header-icon">
								<span class="icon">
									<i class="fas fa-ticket fa-rotate-by" style="--fa-rotate-angle: 135deg;" aria-hidden="true"></i>
								</span>
							</div>
						</header>
						<div class="card-content">
							<div class="content">
								Fun and professional events to connect, learn, and unwind together.
							</div>
						</div>
						<footer class="card-footer">
							<a href="#" class="card-footer-item">Calendar</a>
						</footer>
					</div>
				</div>
				<div class="cell">
					<div class="card">
						<header class="card-header">
							<p class="card-header-title">Exchange</p>
							<div aria-hidden="true" class="card-header-icon">
								<span class="icon">
									<i class="fas fa-comments" aria-hidden="true"></i>
								</span>
							</div>
						</header>
						<div class="card-content">
							<div class="content">
								Share ideas, resources and experiences across research and beyond.
							</div>
						</div>
						<footer class="card-footer">
						{% for social_media_entry in social_media %}
							<a href="{{ social_media_entry.url }}" aria-label="{{ social_media_entry.name }}" class="card-footer-item">
								<span class="icon" aria-hidden="true">
									<i class="{{ social_media_entry.icon }}"></i>
								</span>
								<span class="is-hidden-mobile">{{ social_media_entry.name }}</span>
							</a>
						{% endfor %}
						</footer>
					</div>
				</div>
				<div class="cell">
					<div class="card">
						<header class="card-header">
							<p class="card-header-title">Meet &amp; Connect</p>
							<div aria-hidden="true" class="card-header-icon">
								<span class="icon">
									<i class="fas fa-people-group" aria-hidden="true"></i>
								</span>
							</div>
						</header>
						<div class="card-content">
							<div class="content">
								Build relationships, make friends, and strengthen our postdoc network.
							</div>
						</div>
						<footer class="card-footer">
							<a href="#" class="card-footer-item">
								<span class="icon" aria-hidden="true">
									<i class="fa-brands fa-whatsapp"></i>
								</span>
								<span class="is-hidden-mobile">WhatsApp group</span>
							</a>
							<a href="#" class="card-footer-item">Mailing list</a>
						</footer>
					</div>
				</div>
				<div class="cell">
					<div class="card">
						<header class="card-header">
							<p class="card-header-title">Spread the Word</p>
							<div aria-hidden="true" class="card-header-icon">
								<span class="icon">
									<i class="fas fa-bullhorn" aria-hidden="true"></i>
								</span>
							</div>
						</header>
						<div class="card-content">
							<div class="content">
								Together, we can increase visibility, create opportunities, and make an impact.
							</div>
						</div>
						<footer class="card-footer">
							<a href="#" class="card-footer-item">Become an ambassador</a>
							<a href="#" class="card-footer-item">Add your institution</a>
						</footer>
					</div>
				</div>
			</div>
		</div>
		<div>
			<p>
				Our community already includes postdoctoral researchers from {{ (institutions | length) }} research institutions in the area!
			</p>
			<div class="grid mx-5 mt-3">
				{% set shown_institution_number = 7 %}
				{% for institution in institutions.slice(0, shown_institution_number) %}
					<div class="cell">
						<div class="box is-shadowless is-radiusless institutions-item">
							<figure class="image is-square">
								<img src="{{ institution.logo }}" aria-label="Logo of {{ institution.long_name }}" title="{{ institution.long_name }}" />
							</figure>
						</div>
					</div>
				{% endfor %}
				{% if institutions | length > shown_institution_number %}
					<div class="cell">
						<div class="box is-shadowless is-radiusless institutions-item institutions-etcetera">
							<figure class="image is-square is-flex">
								<p class="title is-2">+{{ (institutions | length) - shown_institution_number }}</p>
							</figure>
						</div>
					</div>
				{% endif %}
			</div>
			<div class="is-flex is-justify-content-center is-align-items-center mt-2">
				<div class="buttons">
					<button class="button is-primary js-modal-trigger" data-target="institutions-list-modal">
						<span class="icon">
							<i class="fas fa-building-flag"></i>
						</span>
						<span>All research institutions</span>
					</button>
					<button class="button is-primary is-outlined">
						<span class="icon">
							<i class="fas fa-user-tie"></i>
						</span>
						<span>Become an ambassador</span>
					</button>
					<button class="button is-primary is-outlined">
						<span class="icon">
							<i class="fas fa-circle-plus"></i>
						</span>
						<span>Add your institution</span>
					</button>
				</div>
			</div>
		</div>
	</div>
</section>
<!-- End Join The Movement Content -->

<!-- Begin Footer -->
