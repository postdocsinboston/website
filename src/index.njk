				</p>
			</div>
			<div class="column has-text-centered-mobile has-text-right-desktop">
				<button class="button is-primary is-inverted js-modal-trigger" data-target="contact-form-modal">
					<span class="icon">
						<i class="fas fa-paper-plane"></i>
					</span>
					<span>Contact us</span>
				</button>
			</div>
		</div>
	</div>
</div>
<!-- End Footer -->

