<!-- Begin Institutions List Modal -->
<div id="institutions-list-modal" class="modal">
	<div class="modal-background"></div>
	<div class="modal-card">
		<header class="modal-card-head">
			<h2 class="modal-card-title">Our Community &amp; Ambassadors</h2>
			<button class="delete" aria-label="close"></button>
		</header>
		<section class="modal-card-body">
			{# <div class="has-text-right mb-4">
				<p><span class="tag">Contact your ambassador or apply as one for your institution below</span><span class="icon"><i class="fas fa-arrow-down"></i></span></p>
			</div> #}
			{% for institution in institutions %}
				<article class="media">
					<div class="media-left">
						<figure class="image is-64x64 is-flex is-align-items-center">
							<img class="institution-logo" alt="" src="{{ institution.logo }}" />
						</figure>
					</div>
					<div class="media-content">
						<h2 class="is-size-5">
							<a class="has-text-inherit" title="Website of {{ institution.long_name }}" href="{{ institution.website }}">
								{{ institution.long_name }}
							</a>
						</h2>
						{% if institution.ambassadors | length > 0 %}
						<p class="ml-4 mt-2">
							{% for ambassador in institution.ambassadors %}
							<span>{{ ambassador.first_name }}</span> <span>{{ ambassador.last_name }}</span> <a href="https://orcid.org/{{ ambassador.orcid }}" title="ORCID record of {{ ambassador.first_name }} {{ ambassador.last_name }}" aria-label="View ORCID record of {{ ambassador.first_name }} {{ ambassador.last_name }}"><span class="icon" aria-hidden="true"><i class="fa-brands fa-orcid"></i></span></a>{{ ", " if not loop.last }}
							{% endfor %}
						</p>
						{% else %}
						<p class="ml-4 mt-2">
							<span class="tag">No ambassadors currently listed</span>
						</p>
						{% endif %}
					</div>
					<div class="media-right">
						<div class="buttons are-small is-flex is-flex-direction-column is-align-items-end">
							{% if institution.ambassadors | length > 0 %}
							<button class="button">
								<span class="icon">
									<i class="fas fa-user-tie"></i>
								</span>
								<span>Contact</span>
							</button>
							{% endif %}
							{% if institution.open_ambassador_applications %}
							<button class="button">
								<span class="icon">
									<i class="fas fa-user-tie"></i>
								</span>
								<span>Apply</span>
							</button>
							{% endif %}
						</div>
					</div>
				</article>
			{% endfor %}
		</section>
		<footer class="modal-card-foot">
			<div class="buttons">
				<button class="button is-primary">
					<span class="icon">
						<i class="fas fa-user-tie"></i>
					</span>
					<span>Become an ambassador</span>
				</button>
				<button class="button is-primary is-outlined">
					<span class="icon">
						<i class="fas fa-circle-plus"></i>
					</span>
					<span>Add your institution</span>
				</button>
				<button type="button" class="button">Close</button>
			</div>
		</footer>
</div>
</div>
<!-- End Institutions List Modal -->
