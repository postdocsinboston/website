<!-- Begin Accessibility Statement Modal -->
<div id="accessibility-statement-modal" class="modal">
	<div class="modal-background"></div>
	<div class="modal-card">
		<header class="modal-card-head">
			<p class="modal-card-title">Accessibility</p>
			<button class="delete" aria-label="close"></button>
		</header>
		<section class="modal-card-body">
            <div class="content">
                {{ accessibility_statement | safe }}
            </div>
		</section>
		<footer class="modal-card-foot">
			<div class="buttons">
                <a href="https://github.com/postdocsinboston/website/issues/new?template=accessibility-issue.yml" target="_blank" class="button is-primary">
					<span class="icon">
						<i class="fab fa-github"></i>
					</span>
					<span>Raise an issue</span>
				</a>
                <a href="#" target="_blank" class="button is-primary is-outlined">
					<span class="icon">
						<i class="fas fa-at"></i>
					</span>
					<span>Send an email</span>
				</a>
				<button type="button" class="button">Close</button>
			</div>
		</footer>
    </div>
</div>
<!-- End Accessibility Statement Modal -->
