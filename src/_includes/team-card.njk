						<div class="column is-one-fifth-desktop is-half-tablet is-full-mobile has-text-centered">
							<figure class="image is-1by1 work-item" style="background-image: url('{{ member | avatarUrl }}');"></figure>
							<p class="heading"><strong>{{ member.first_name }}</strong></p>
							{% if member.title %}<p class="subheading">{{ member.title }}</p>{% endif %}
							{% if member.domains %}<p class="is-size-7">{{ member.domains | join(" &middot; ") | safe }}</p>{% endif %}
							{% set x_url = member.social_media.x or member.social_media.twitter %}
							{% if member.social_media.linkedin or x_url or member.social_media.instagram or member.social_media.github or member.social_media.tiktok or member.social_media.threads or member.orcid or member.email %}
							<div class="team-social">
								{% if member.social_media.linkedin %}<a href="{{ member.social_media.linkedin }}" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-linkedin"></i></a>{% endif %}
								{% if x_url %}<a href="{{ x_url }}" aria-label="X" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-x-twitter"></i></a>{% endif %}
								{% if member.social_media.instagram %}<a href="{{ member.social_media.instagram }}" aria-label="Instagram" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-instagram"></i></a>{% endif %}
								{% if member.social_media.github %}<a href="{{ member.social_media.github }}" aria-label="Github" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-github"></i></a>{% endif %}
								{% if member.social_media.tiktok %}<a href="{{ member.social_media.tiktok }}" aria-label="Tiktok" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-tiktok"></i></a>{% endif %}
								{% if member.social_media.threads %}<a href="{{ member.social_media.threads }}" aria-label="Threads" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-threads"></i></a>{% endif %}
								{% if member.orcid %}<a href="https://orcid.org/{{ member.orcid }}" aria-label="ORCID" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-orcid"></i></a>{% endif %}
								{% if member.email %}<a href="mailto:{{ member.email }}" aria-label="Email"><i class="fas fa-envelope"></i></a>{% endif %}
							</div>
							{% endif %}
						</div>
